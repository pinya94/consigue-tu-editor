{
  "name": "cupcut",
  "version": "0.1.0",
  "description": "Editor de vídeo de escritorio pensado para trabajar a medias con Claude",
  "main": "electron/main.mjs",
  "type": "module",
  "bin": {
    "cupcut": "cli/cupcut.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env CUPCUT_DEV_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "typecheck": "tsc --noEmit",
    "cupcut": "node cli/cupcut.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
