{
  "name": "consigue-tu-editor",
  "version": "0.2.0",
  "description": "Consigue tu editor de vídeo optimizado para Claude gratis: editor de vídeo de escritorio para editar a medias con Claude",
  "main": "electron/main.mjs",
  "type": "module",
  "bin": {
    "consigue-tu-editor": "cli/editor.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env EDITOR_DEV_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dist": "vite build && electron-builder --win",
    "cli": "node cli/editor.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "author": "Consigue tu algo gratis",
  "build": {
    "appId": "com.consiguetualgogratis.editor",
    "productName": "Consigue tu editor de video optimizado para Claude gratis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "core/**",
      "cli/**",
      "docs/**",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "ConsigueTuEditor"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ConsigueTuEditor-Setup.exe",
      "shortcutName": "Consigue tu editor de vídeo optimizado para Claude gratis",
      "uninstallDisplayName": "Consigue tu editor de vídeo optimizado para Claude gratis"
    }
  },
  "license": "MIT"
}
